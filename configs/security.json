{
  "schema": "myln-tune/1",
  "name": "security",
  "description": "Security monitoring (Chibitaru compatible). Same behaviour as tune_security() with default params.",
  "classes": ["SAFE", "LOW", "MEDIUM", "HIGH", "CRITICAL"],
  "features": ["proc_anomaly", "cpu_spike", "net_bytes", "file_change", "mem_pressure"],
  "in_dim": 5,
  "router": {
    "normalize": false,
    "slots": [
      { "terms": [[0, 0, 5.0]] },
      { "terms": [[0, 2, 5.0]] },
      { "terms": [[0, 3, 5.0]] },
      { "terms": [[0, 1, 2.5], [0, 4, 2.5]] }
    ]
  },
  "heads": [
    { "type": "passthrough", "name": "proc" },
    { "type": "passthrough", "name": "net" },
    { "type": "passthrough", "name": "file" },
    { "type": "passthrough", "name": "resource" }
  ],
  "ring": { "mode": "near_identity", "self": 0.6, "neighbor": 0.2 },
  "center": {
    "normalize_agg": false,
    "key": "identity",
    "query": [[0, 3.0]],
    "cls": {
      "terms": [[0, 0, -1.0], [1, 0, 0.5], [2, 0, 1.5], [3, 0, 2.5], [4, 0, 3.5]],
      "bias":  [[0, 9.25], [1, 8.5], [2, 7.0], [3, 4.2], [4, 0.0]]
    }
  }
}
