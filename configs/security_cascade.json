{
  "schema": "myln-tune/1",
  "name": "security-cascade",
  "description": "Security monitoring as a 2-stage cascade. Same behaviour as tune_cascade_security().",
  "classes": ["SAFE", "LOW", "MEDIUM", "HIGH", "CRITICAL"],
  "features": ["proc_anomaly", "cpu_spike", "net_bytes", "file_change", "mem_pressure"],
  "threshold": 0.80,
  "relay": {
    "size": "SS",
    "in_dim": 5,
    "router": {
      "normalize": false,
      "slots": [
        { "terms": [[0, 0, 7.0]] },
        { },
        { "terms": [[0, 3, 5.0]] },
        { }
      ]
    },
    "heads": [
      { "type": "passthrough", "name": "relay/proc" },
      "zero",
      { "type": "passthrough", "name": "relay/file" },
      "zero"
    ],
    "ring": { "mode": "near_identity", "self": 0.9, "neighbor": 0.05 },
    "center": {
      "normalize_agg": false,
      "key": "identity",
      "query": [[0, 4.0]],
      "cls": {
        "terms": [[0, 0, -2.0], [1, 0, 1.0], [2, 0, 3.0], [3, 0, 5.0], [4, 0, 7.0]],
        "bias":  [[0, 18.5], [1, 17.0], [2, 14.0], [3, 8.4], [4, 0.0]]
      }
    }
  },
  "full": {
    "size": "T",
    "in_dim": 5,
    "router": {
      "normalize": false,
      "slots": [
        { "terms": [[0, 0, 5.0]] },
        { "terms": [[0, 2, 5.0]] },
        { "terms": [[0, 3, 5.0]] },
        { "terms": [[0, 1, 2.5], [0, 4, 2.5]] }
      ]
    },
    "heads": [
      { "type": "passthrough", "name": "proc" },
      { "type": "passthrough", "name": "net" },
      { "type": "passthrough", "name": "file" },
      { "type": "passthrough", "name": "resource" }
    ],
    "ring": { "mode": "near_identity", "self": 0.6, "neighbor": 0.2 },
    "center": {
      "normalize_agg": false,
      "key": "identity",
      "query": [[0, 3.0]],
      "cls": {
        "terms": [[0, 0, -1.0], [1, 0, 0.5], [2, 0, 1.5], [3, 0, 2.5], [4, 0, 3.5]],
        "bias":  [[0, 9.25], [1, 8.5], [2, 7.0], [3, 4.2], [4, 0.0]]
      }
    }
  }
}
